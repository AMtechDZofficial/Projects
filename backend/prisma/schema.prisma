generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentification ────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(MANAGER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
}

// ─── Fournisseurs ────────────────────────────────────────────────────────────

model Supplier {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean    @default(true)
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ─── Matières Premières ──────────────────────────────────────────────────────

model Material {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  category        MaterialCategory
  unit            String
  unitCost        Decimal            @db.Decimal(12, 4)
  stockQuantity   Decimal            @default(0) @db.Decimal(12, 3)
  minimumStock    Decimal            @default(0) @db.Decimal(12, 3)
  supplierId      String?
  supplier        Supplier?          @relation(fields: [supplierId], references: [id])
  movements       MaterialMovement[]
  modelComponents ModelComponent[]
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([category])
  @@index([supplierId])
}

enum MaterialCategory {
  TISSU
  FIL
  BOUTON
  FERMETURE
  DOUBLURE
  ELASTIQUE
  DENTELLE
  BRODERIE
  EMBALLAGE
  AUTRE
}

model MaterialMovement {
  id          String       @id @default(cuid())
  materialId  String
  material    Material     @relation(fields: [materialId], references: [id])
  type        MovementType
  quantity    Decimal      @db.Decimal(12, 3)
  unitCost    Decimal      @db.Decimal(12, 4)
  totalCost   Decimal      @db.Decimal(12, 2)
  reference   String?
  notes       String?
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([materialId])
  @@index([date])
}

enum MovementType {
  ENTREE
  SORTIE
  AJUSTEMENT
}

// ─── Modèles de Vêtements ────────────────────────────────────────────────────

model CoutureModel {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  category           String
  description        String?
  salePrice          Decimal?            @db.Decimal(12, 2)
  constructionNotes  String?
  careInstructions   String?
  labelInfo          String?
  isActive           Boolean             @default(true)
  components         ModelComponent[]
  operations         ModelOperation[]
  productionOrders   ProductionOrder[]
  semiFinished       SemiFinishedStock[]
  finishedStock      FinishedStock[]
  pieceProductions   PieceProduction[]
  clientOrderLines   ClientOrderLine[]
  deliveryLines      DeliveryLine[]
  patternPieces      PatternPiece[]
  gradationRows      GradationRow[]
  fittingSessions    FittingSession[]
  prototypeDev       PrototypeDev?
  colorVariants      ColorVariant[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([category])
}

model ModelComponent {
  id         String       @id @default(cuid())
  modelId    String
  model      CoutureModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  materialId String
  material   Material     @relation(fields: [materialId], references: [id])
  quantity   Decimal      @db.Decimal(12, 4)
  unit       String?
  notes      String?

  @@unique([modelId, materialId])
  @@index([modelId])
}

model ModelOperation {
  id               String               @id @default(cuid())
  modelId          String
  model            CoutureModel         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  machineType      String?
  standardMinutes  Decimal              @db.Decimal(8, 2)
  sequence         Int                  @default(0)
  phase            String?
  stitchType       String?
  pieceProductions PieceProduction[]
  semiFinished     SemiFinishedStock[]
  pieceRates       PieceRate[]
  assignments      OperatorAssignment[]
  qualityChecks    QualityCheck[]

  @@index([modelId])
}

// ─── Production ──────────────────────────────────────────────────────────────

model ProductionOrder {
  id          String               @id @default(cuid())
  orderNumber String               @unique
  modelId     String
  model       CoutureModel         @relation(fields: [modelId], references: [id])
  quantity    Int
  status      OrderStatus          @default(EN_ATTENTE)
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  assignments   OperatorAssignment[]
  clientOrderId String?
  clientOrder   ClientOrder?        @relation(fields: [clientOrderId], references: [id])
  schedule      ProductionSchedule?
  qualityChecks QualityCheck[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([modelId])
  @@index([status])
}

enum OrderStatus {
  EN_ATTENTE
  EN_COURS
  TERMINE
  ANNULE
}

// ─── Stock Produits Semi-Finis (Encours) ─────────────────────────────────────

model SemiFinishedStock {
  id          String         @id @default(cuid())
  modelId     String
  model       CoutureModel   @relation(fields: [modelId], references: [id])
  operationId String
  operation   ModelOperation @relation(fields: [operationId], references: [id])
  quantity    Decimal        @db.Decimal(10, 0)
  date        DateTime       @default(now())
  notes       String?
  createdAt   DateTime       @default(now())

  @@index([modelId])
  @@index([operationId])
}

// ─── Stock Produits Finis ────────────────────────────────────────────────────

model FinishedStock {
  id             String       @id @default(cuid())
  modelId        String
  model          CoutureModel @relation(fields: [modelId], references: [id])
  quantity       Decimal      @db.Decimal(10, 0)
  productionCost Decimal?     @db.Decimal(12, 2)
  type           StockMovType @default(ENTREE)
  reference      String?
  notes          String?
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([modelId])
  @@index([date])
}

enum StockMovType {
  ENTREE
  SORTIE
  AJUSTEMENT
}

// ─── Employés ────────────────────────────────────────────────────────────────

model Employee {
  id               String               @id @default(cuid())
  employeeId       String               @unique
  firstName        String
  lastName         String
  position         String
  department       String?
  paymentType      PaymentType
  hourlyRate       Decimal?             @db.Decimal(10, 2)
  monthlyRate      Decimal?             @db.Decimal(10, 2)
  phone            String?
  hireDate         DateTime
  isActive         Boolean              @default(true)
  pieceRates       PieceRate[]
  pieceProductions PieceProduction[]
  payrolls         Payroll[]
  assignments      OperatorAssignment[]
  attendance       Attendance[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([paymentType])
  @@index([isActive])
}

enum PaymentType {
  PIECE
  CHAINE
  HORAIRE
  MENSUEL
}

model PieceRate {
  id            String          @id @default(cuid())
  employeeId    String
  employee      Employee        @relation(fields: [employeeId], references: [id])
  operationId   String?
  operation     ModelOperation? @relation(fields: [operationId], references: [id])
  operationName String
  rate          Decimal         @db.Decimal(10, 4)
  effectiveDate DateTime        @default(now())
  isActive      Boolean         @default(true)

  @@index([employeeId])
}

model PieceProduction {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id])
  modelId     String
  model       CoutureModel    @relation(fields: [modelId], references: [id])
  operationId String?
  operation   ModelOperation? @relation(fields: [operationId], references: [id])
  quantity    Int
  pieceRate   Decimal         @db.Decimal(10, 4)
  totalAmount Decimal         @db.Decimal(10, 2)
  date        DateTime        @default(now())
  notes       String?
  createdAt   DateTime        @default(now())

  @@index([employeeId])
  @@index([date])
  @@index([modelId])
}

// ─── Paie ────────────────────────────────────────────────────────────────────

model Payroll {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  workDays      Int           @default(0)
  hoursWorked   Decimal       @default(0) @db.Decimal(8, 2)
  baseSalary    Decimal       @db.Decimal(12, 2)
  pieceEarnings Decimal       @default(0) @db.Decimal(12, 2)
  chainBonus    Decimal       @default(0) @db.Decimal(12, 2)
  bonus         Decimal       @default(0) @db.Decimal(12, 2)
  deductions    Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        PayrollStatus @default(BROUILLON)
  notes         String?
  createdAt     DateTime      @default(now())
  paidAt        DateTime?

  @@index([employeeId])
  @@index([periodStart, periodEnd])
}

enum PayrollStatus {
  BROUILLON
  VALIDE
  PAYE
}

// ─── Machines ────────────────────────────────────────────────────────────────

model Machine {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  type        MachineType
  brand       String?
  model       String?
  status      MachineStatus        @default(DISPONIBLE)
  location    String?
  notes       String?
  assignments OperatorAssignment[]
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([type])
  @@index([status])
}

enum MachineType {
  MACHINE_PLATE
  SURJETEUSE
  BOUTONNIERE
  MACHINE_BOUTON
  TABLE_COUPE
  FER_REPASSAGE
  MACHINE_CANON
  BRODERIE
  POINT_INVISIBLE
  PRESSE
  AUTRE
}

enum MachineStatus {
  DISPONIBLE
  EN_SERVICE
  EN_PANNE
  MAINTENANCE
}

// ─── Affectation Opérateurs ──────────────────────────────────────────────────

model OperatorAssignment {
  id             String          @id @default(cuid())
  orderId        String
  order          ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id])
  operationId    String
  operation      ModelOperation  @relation(fields: [operationId], references: [id])
  machineId      String?
  machine        Machine?        @relation(fields: [machineId], references: [id])
  targetQuantity Int             @default(0)
  actualQuantity Int             @default(0)
  shiftType      ShiftType       @default(JOURNEE)
  date           DateTime        @default(now())
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orderId])
  @@index([employeeId])
  @@index([operationId])
}

enum ShiftType {
  MATIN
  APRES_MIDI
  JOURNEE
}

// ─── Gestion Commerciale ─────────────────────────────────────────────────────

model Client {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  contact      String?
  phone        String?
  email        String?
  address      String?
  city         String?
  rc           String?
  nif          String?
  paymentTerms Int           @default(30)
  isActive     Boolean       @default(true)
  orders       ClientOrder[]
  invoices     Invoice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum ClientOrderStatus {
  DEVIS
  CONFIRMEE
  EN_PRODUCTION
  PARTIELLEMENT_LIVREE
  LIVREE
  FACTUREE
  PAYEE
  ANNULEE
}

model ClientOrder {
  id               String            @id @default(cuid())
  orderNumber      String            @unique
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status           ClientOrderStatus @default(DEVIS)
  orderDate        DateTime          @default(now())
  deliveryDate     DateTime
  totalAmount      Decimal           @default(0) @db.Decimal(12, 2)
  depositAmount    Decimal           @default(0) @db.Decimal(12, 2)
  notes            String?
  lines            ClientOrderLine[]
  productionOrders ProductionOrder[]
  deliveries       Delivery[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([deliveryDate])
}

model ClientOrderLine {
  id            String       @id @default(cuid())
  orderId       String
  order         ClientOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modelId       String
  model         CoutureModel @relation(fields: [modelId], references: [id])
  colorRef      String?
  sizeBreakdown Json
  quantity      Int
  unitPrice     Decimal      @db.Decimal(12, 2)
  totalPrice    Decimal      @db.Decimal(12, 2)

  @@index([orderId])
  @@index([modelId])
}

// ─── Expédition & Facturation ────────────────────────────────────────────────

enum DeliveryStatus {
  EN_PREPARATION
  LIVRE
  SIGNE
  RETOUR_PARTIEL
}

model Delivery {
  id             String         @id @default(cuid())
  deliveryNumber String         @unique
  orderId        String
  order          ClientOrder    @relation(fields: [orderId], references: [id])
  deliveryDate   DateTime       @default(now())
  status         DeliveryStatus @default(EN_PREPARATION)
  carrierName    String?
  trackingNumber String?
  signedAt       DateTime?
  notes          String?
  lines          DeliveryLine[]
  invoice        Invoice?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([deliveryDate])
}

model DeliveryLine {
  id            String       @id @default(cuid())
  deliveryId    String
  delivery      Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  modelId       String
  model         CoutureModel @relation(fields: [modelId], references: [id])
  colorRef      String?
  sizeBreakdown Json
  quantity      Int

  @@index([deliveryId])
}

enum InvoiceStatus {
  BROUILLON
  EMISE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

enum PaymentMethod {
  VIREMENT
  CHEQUE
  ESPECES
  TRAITE
  AUTRE
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  deliveryId    String        @unique
  delivery      Delivery      @relation(fields: [deliveryId], references: [id])
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(12, 2)
  tvaRate       Decimal       @default(19) @db.Decimal(5, 2)
  tvaAmount     Decimal       @db.Decimal(12, 2)
  timbre        Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(BROUILLON)
  notes         String?
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([invoiceId])
}

// ─── Présence Opérateurs ─────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  CONGE
  MALADIE
  REPOS
  MISSION
}

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  arrivedAt   String?
  leftAt      String?
  hoursWorked Decimal?         @db.Decimal(5, 2)
  notes       String?
  approvedBy  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

// ─── Planification ───────────────────────────────────────────────────────────

model ProductionSchedule {
  id            String          @id @default(cuid())
  orderId       String          @unique
  order         ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plannedStart  DateTime
  plannedEnd    DateTime
  estimatedDays Decimal         @db.Decimal(8, 2)
  actualStart   DateTime?
  actualEnd     DateTime?
  priority      Int             @default(0)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ─── Contrôle Qualité ────────────────────────────────────────────────────────

enum DefectSeverity {
  MINEUR
  MAJEUR
  CRITIQUE
}

model DefectType {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  severity    DefectSeverity
  description String?
  isActive    Boolean         @default(true)
  defects     QualityDefect[]
  createdAt   DateTime        @default(now())
}

enum CheckType {
  EN_COURS
  FINAL
}

enum QCStatus {
  EN_ATTENTE
  VALIDE
  BLOQUE
}

model QualityCheck {
  id               String          @id @default(cuid())
  orderId          String
  order            ProductionOrder @relation(fields: [orderId], references: [id])
  operationId      String?
  operation        ModelOperation? @relation(fields: [operationId], references: [id])
  checkType        CheckType       @default(EN_COURS)
  checkedById      String
  checkDate        DateTime        @default(now())
  quantityChecked  Int
  quantityPassed   Int
  quantityRework   Int             @default(0)
  quantityRejected Int             @default(0)
  firstPassYield   Decimal         @db.Decimal(5, 2)
  status           QCStatus        @default(EN_ATTENTE)
  notes            String?
  defects          QualityDefect[]
  createdAt        DateTime        @default(now())

  @@index([orderId])
  @@index([checkDate])
}

model QualityDefect {
  id           String       @id @default(cuid())
  checkId      String
  check        QualityCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  defectTypeId String
  defectType   DefectType   @relation(fields: [defectTypeId], references: [id])
  quantity     Int
  operationId  String?
  notes        String?

  @@index([checkId])
}

// ─── Configuration Atelier ───────────────────────────────────────────────────

model WorkshopConfig {
  id                  String   @id @default(cuid())
  name                String   @default("Atelier Principal")
  workDaysPerMonth    Int      @default(26)
  hoursPerDay         Decimal  @default(8) @db.Decimal(4, 2)
  overheadPercent     Decimal  @default(15) @db.Decimal(5, 2)
  numberOfOperators   Int      @default(10)
  targetEfficiency    Decimal  @default(80) @db.Decimal(5, 2)
  currency            String   @default("DZD")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

// ─── Documents Techniques Modèle ─────────────────────────────────────────────

model PatternPiece {
  id            String       @id @default(cuid())
  modelId       String
  model         CoutureModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  pieceName     String
  fabricType    String       // PRINCIPAL, DOUBLURE, ENTOILAGE, THERMOCOLLANT, AUTRE
  dimensions    String?
  grainLine     String?      // DROIT_FIL, BIAIS, SANS_CONTRAINTE
  quantity      Int          @default(1)
  seamAllowance Decimal?     @db.Decimal(4, 1)
  notes         String?
  sequence      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([modelId])
}

model GradationRow {
  id          String       @id @default(cuid())
  modelId     String
  model       CoutureModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  measurement String
  xs          Decimal?     @db.Decimal(6, 1)
  s           Decimal?     @db.Decimal(6, 1)
  m           Decimal?     @db.Decimal(6, 1)
  l           Decimal?     @db.Decimal(6, 1)
  xl          Decimal?     @db.Decimal(6, 1)
  xxl         Decimal?     @db.Decimal(6, 1)
  unit        String       @default("cm")
  sequence    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([modelId])
}

model FittingSession {
  id            String       @id @default(cuid())
  modelId       String
  model         CoutureModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  sessionNumber Int
  date          DateTime?
  fitterName    String?
  corrections   Json?
  decision      String?      // VALIDE, REVISION, REJETE
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([modelId, sessionNumber])
  @@index([modelId])
}

model PrototypeDev {
  id              String       @id @default(cuid())
  modelId         String       @unique
  model           CoutureModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  responsable     String?
  toileDate       DateTime?
  toileNotes      String?
  proto1Date      DateTime?
  proto1Notes     String?
  proto1Decision  String?
  proto2Date      DateTime?
  proto2Notes     String?
  proto2Decision  String?
  validationDate  DateTime?
  validationNotes String?
  productionReady Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ColorVariant {
  id              String       @id @default(cuid())
  modelId         String
  model           CoutureModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  colorName       String
  colorCode       String?
  fabricRef       String?
  liningRef       String?
  accessoriesRefs String?
  isValidated     Boolean      @default(false)
  notes           String?
  sequence        Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([modelId])
}
